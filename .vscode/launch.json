  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'ai-operator'",
      "cargo": {
        "args": ["build", "--bin=ai-operator", "--package=ai-operator"],
        "filter": {
          "name": "ai-operator",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'ai-operator'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bin=ai-operator",
          "--package=ai-operator"
        ],
        "filter": {
          "name": "ai-operator",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
